<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FoodStock Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

<div class="flex">

  <!-- ========== SIDEBAR ========== -->
  <aside class="w-64 min-h-screen bg-white shadow-md p-4 flex flex-col justify-between">

    <!-- Logo Section -->
    <div>
      <div class="flex items-center space-x-3 mb-8">
        <img src="your-logo.png" alt="FoodStock Logo" class="w-10 h-10">
        <h1 class="text-2xl font-bold text-emerald-600">FoodStock</h1>
      </div>

      <nav class="space-y-2">
        <a class="block px-4 py-2 bg-emerald-100 rounded-md">Dashboard</a>
        <a class="block px-4 py-2 hover:bg-gray-200 rounded-md">View Inventory</a>

        <!-- Buttons trigger notifications -->
        <a id="btnStockIn" class="block px-4 py-2 hover:bg-gray-200 rounded-md cursor-pointer">Stock In</a>
        <a id="btnStockOut" class="block px-4 py-2 hover:bg-gray-200 rounded-md cursor-pointer">Stock Out</a>

        <a class="block px-4 py-2 hover:bg-gray-200 rounded-md">Request Supplies</a>
        <a class="block px-4 py-2 hover:bg-gray-200 rounded-md">My Activity</a>
        <a class="block px-4 py-2 hover:bg-gray-200 rounded-md">Profile</a>
      </nav>
    </div>

    <!-- User Profile -->
    <div class="flex items-center space-x-3 mt-10 p-3 border-t">
      <img src="user.png" alt="User Avatar" class="w-10 h-10 rounded-full object-cover">
      <div>
        <p class="font-semibold">Serdan Angel Brigeth</p>
        <span class="text-sm text-gray-500">User</span>
      </div>
    </div>

  </aside>

  <!-- ========== MAIN CONTENT ========== -->
  <main class="flex-1 p-8">

    <!-- Header WITH Notification -->
    <div class="flex justify-between items-center">
      <div>
        <h2 class="text-xl font-semibold">Dashboard</h2>
        <p class="text-gray-500">Saturday, December 6, 2025</p>
      </div>

      <!-- NOTIFICATION BUTTON -->
      <div class="relative">
        <button id="notifBtn" class="relative w-10 h-10 rounded-full bg-white shadow flex items-center justify-center hover:bg-gray-100">
          <svg xmlns="http://www.w3.org/2000/svg"
               fill="none" viewBox="0 0 24 24" stroke-width="2"
               stroke="currentColor" class="w-6 h-6 text-gray-600">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M14.857 17.657a1.657 1.657 0 01-3.314 0m6.314-6.314a6 6 0 10-12 0c0 
                  2.577-.563 4.385-1.316 5.553-.59.92-.885 1.38-.873 1.792.012.44.177.778.54 
                  1.142C4.62 20.81 5.47 21 12 21s7.38-.19 7.592-.17c.363-.364.528-.702.54-1.142.012-.412-.283-.872-.873-1.792-.753-1.168-1.316-2.976-1.316-5.553z" />
          </svg>

          <!-- Notification Badge -->
          <span id="notifCount" class="absolute top-0 right-0 bg-red-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center">
            0
          </span>
        </button>

        <!-- NOTIFICATION DROPDOWN -->
        <div id="notifPanel" class="hidden absolute right-0 mt-2 w-64 bg-white shadow-xl rounded-lg p-4 z-20">
          <div class="flex justify-between items-center">
            <h3 class="font-semibold">Notifications</h3>
            <button id="clearNotifs" class="text-xs text-red-500 underline">Clear all</button>
          </div>
          <ul id="notifList" class="mt-3 space-y-2 text-sm text-gray-700"></ul>
        </div>
      </div>
    </div>

    <!-- Welcome Banner -->
    <div class="bg-emerald-600 text-white p-6 rounded-xl mt-6 shadow">
      <h3 class="text-2xl font-semibold">Welcome back, Serdan Angel Brigeth!</h3>
      <p>Here's your inventory overview for today.</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-4 gap-4 mt-6">

      <div class="bg-white p-4 shadow rounded-xl">
        <p class="text-gray-600">Total Items</p>
        <h1 class="text-3xl font-bold">8</h1>
        <span class="text-sm text-gray-400">In inventory</span>
      </div>

      <div class="bg-white p-4 shadow rounded-xl">
        <p class="text-gray-600">Low Stock</p>
        <h1 class="text-3xl font-bold text-orange-500">2</h1>
        <span class="text-sm text-gray-400">Need attention</span>
      </div>

      <div class="bg-white p-4 shadow rounded-xl">
        <p class="text-gray-600">Expiring Soon</p>
        <h1 class="text-3xl font-bold text-red-500">0</h1>
        <span class="text-sm text-gray-400">Within 7 days</span>
      </div>

      <div class="bg-white p-4 shadow rounded-xl">
        <p class="text-gray-600">My Requests</p>
        <h1 class="text-3xl font-bold text-blue-500">0</h1>
        <span class="text-sm text-gray-400">Pending approval</span>
      </div>

    </div>

    <!-- Quick Actions -->
    <div class="grid grid-cols-4 gap-4 mt-6">
      <button id="quickStockIn" class="bg-emerald-100 p-6 rounded-xl shadow text-center hover:bg-emerald-200">
        Stock In
      </button>
      <button id="quickStockOut" class="bg-blue-100 p-6 rounded-xl shadow text-center hover:bg-blue-200">
        Stock Out
      </button>
      <button class="bg-purple-100 p-6 rounded-xl shadow text-center hover:bg-purple-200">
        View Inventory
      </button>
      <button class="bg-yellow-100 p-6 rounded-xl shadow text-center hover:bg-yellow-200">
        Request Supplies
      </button>
    </div>

    <!-- Low Stock Warning -->
    <div class="bg-yellow-50 p-6 rounded-xl mt-6 shadow">
      <h3 class="text-lg font-semibold text-orange-600">⚠ Low Stock Items</h3>

      <div class="mt-4 flex justify-between border-b pb-2">
        <span>Organic Milk</span>
        <span class="text-gray-600">8 liters left</span>
      </div>

      <div class="mt-2 flex justify-between">
        <span>Frozen Shrimp</span>
        <span class="text-gray-600">5 kg left</span>
      </div>
    </div>

  </main>

</div>


<!-- ========== JAVASCRIPT CODE ========== -->
<script>
  const notifBtn   = document.getElementById("notifBtn");
  const notifPanel = document.getElementById("notifPanel");
  const notifList  = document.getElementById("notifList");
  const notifCount = document.getElementById("notifCount");
  const clearBtn   = document.getElementById("clearNotifs");

  const btnStockIn  = document.getElementById("btnStockIn");
  const btnStockOut = document.getElementById("btnStockOut");

  const quickStockIn  = document.getElementById("quickStockIn");
  const quickStockOut = document.getElementById("quickStockOut");

  let notifications = [];

  // Toggle notification dropdown
  notifBtn.addEventListener("click", () => {
    notifPanel.classList.toggle("hidden");
  });

  // Add notification function
  function addNotification(message) {
    notifications.push(message);
    notifCount.textContent = notifications.length;

    const li = document.createElement("li");
    li.classList.add("p-2", "rounded", "bg-gray-100");
    li.textContent = message;

    notifList.appendChild(li);
  }

  // Clear notifications
  clearBtn.addEventListener("click", () => {
    notifications = [];
    notifList.innerHTML = "";
    notifCount.textContent = 0;
  });

  // Stock In events
  btnStockIn.addEventListener("click", () => addNotification("📦 Stock-In recorded!"));
  quickStockIn.addEventListener("click", () => addNotification("📦 Stock-In recorded!"));

  // Stock Out events
  btnStockOut.addEventListener("click", () => addNotification("📤 Stock-Out recorded!"));
  quickStockOut.addEventListener("click", () => addNotification("📤 Stock-Out recorded!"));
</script>

</body>
</html>
